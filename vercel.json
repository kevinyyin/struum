{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/static/index.html" },
    { "source": "/data/:id/:file", "destination": "/api/data?id=:id&file=:file" },
    { "source": "/api/songs/:id/chords", "destination": "/api/chords?id=:id" }
  ],
  "headers": [
    { "source": "/static/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
